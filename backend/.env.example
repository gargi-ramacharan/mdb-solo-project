# Which LLM reviews flagged text: "none" (default: rules + OCR only), "ollama" (local, free) or "anthropic"
LLM_PROVIDER=none

# Anthropic (Claude Haiku 4.5), only used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Ollama, only used when LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_URL=http://localhost:11434

# OCR visual diff (default true). false skips it; scans still work.
ENABLE_VISUAL_DIFF=true

# Deployed web app origin(s) allowed by CORS, comma-separated. localhost is always allowed.
ALLOWED_ORIGINS=

# In-memory scan cache for the legacy endpoints. Default: on locally, off on Vercel.
# SCAN_CACHE=true
